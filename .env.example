ANTHROPIC_API_KEY=
GOOGLE_CREDENTIALS_PATH=secrets/credentials.json
POLL_MINUTES=15
AUTO_APPLY_CONFIDENCE=0.85
PLAN_THRESHOLD=60
GHOST_DAYS=21
# Optional: override the SQLite file location (default data/jobpilot.db)
# DB_PATH=data/jobpilot.db

# Optional: run AI features with deterministic offline stand-ins (no API key needed)
# JOBPILOT_MOCK_AI=1
# Optional: override model ids
# CLAUDE_FAST_MODEL=claude-haiku-4-5
# CLAUDE_SMART_MODEL=claude-sonnet-5

# Optional notifications (P5): ntfy.sh topic (or full URL) and local hour for the daily digest (-1 = off)
# NTFY_TOPIC=
# DIGEST_HOUR=8
